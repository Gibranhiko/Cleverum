{
  "name": "cleverum-chatbot",
  "version": "2.0.0",
  "description": "Cleverum WhatsApp Cloud API webhook handler",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
